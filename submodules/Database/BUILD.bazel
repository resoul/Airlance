load("@rules_swift//swift:swift_library.bzl", "swift_library")

swift_library(
    name = "DatabaseAPI",
    module_name = "DatabaseAPI",
    srcs = glob(["API/**/*.swift"]),
    copts = ["-swift-version", "6"],
    deps = ["//submodules/Observers"],
    visibility = ["//visibility:public"],
)

swift_library(
    name = "Database",
    module_name = "Database",
    srcs = glob(["Sources/**/*.swift"]),
    copts = ["-swift-version", "6"],
    deps = [
        ":DatabaseAPI",
        "//libraries/grdb",
        "//submodules/Observers",
    ],
    visibility = ["//:__pkg__"],
)
