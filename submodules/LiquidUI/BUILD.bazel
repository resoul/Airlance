load("@rules_apple//apple:resources.bzl", "apple_metal_library", "apple_resource_bundle")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

apple_metal_library(
    name = "LiquidShaders",
    srcs = glob(["Shaders/*.metal"]),
    out = "LiquidUI.metallib",
)

apple_resource_bundle(
    name = "LiquidUIResources",
    bundle_name = "LiquidUI",
    resources = [":LiquidShaders"],
)

swift_library(
    name = "LiquidUI",
    module_name = "LiquidUI",
    srcs = glob(["Sources/**/*.swift"]),
    copts = ["-swift-version", "6"],
    data = [":LiquidUIResources"],
    deps = ["//submodules/Haptics"],
    visibility = ["//visibility:public"],
)
