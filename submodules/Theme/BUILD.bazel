load("@rules_apple//apple:resources.bzl", "apple_resource_bundle")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

apple_resource_bundle(
    name = "ThemeResources",
    bundle_name = "Theme",
    resources = glob(["Resources/Fonts/*"]),
)

swift_library(
    name = "Theme",
    module_name = "Theme",
    srcs = glob(["Sources/**/*.swift"]),
    copts = ["-swift-version", "6"],
    data = [":ThemeResources"],
    deps = [
        "//submodules/Database:DatabaseAPI",
        "//submodules/Observers",
    ],
    visibility = ["//visibility:public"],
)
