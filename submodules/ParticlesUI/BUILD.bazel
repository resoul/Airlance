load("@rules_apple//apple:resources.bzl", "apple_metal_library", "apple_resource_bundle")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

apple_metal_library(
    name = "ParticlesShaders",
    srcs = glob(["Shaders/*.metal"]),
    out = "ParticlesUI.metallib",
)

apple_resource_bundle(
    name = "ParticlesUIResources",
    bundle_name = "ParticlesUI",
    resources = [":ParticlesShaders"],
)

swift_library(
    name = "ParticlesUI",
    module_name = "ParticlesUI",
    srcs = glob(["Sources/**/*.swift"]),
    copts = ["-swift-version", "6"],
    data = [":ParticlesUIResources"],
    deps = ["//submodules/LiquidUI"],
    visibility = ["//visibility:public"],
)
