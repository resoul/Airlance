load("@rules_apple//apple:resources.bzl", "apple_metal_library", "apple_resource_bundle")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

apple_metal_library(
    name = "EffectsShaders",
    srcs = glob(["Shaders/*.metal"]),
    out = "EffectsUI.metallib",
)

apple_resource_bundle(
    name = "EffectsUIResources",
    bundle_name = "EffectsUI",
    resources = [":EffectsShaders"],
)

swift_library(
    name = "EffectsUI",
    module_name = "EffectsUI",
    srcs = glob(["Sources/**/*.swift"]),
    copts = ["-swift-version", "6"],
    data = [":EffectsUIResources"],
    deps = [
        "//submodules/Haptics",
        "//submodules/LiquidUI",
    ],
    visibility = ["//visibility:public"],
)
