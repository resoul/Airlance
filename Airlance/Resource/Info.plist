<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>uk</string>
        <string>es</string>
        <string>ru</string>
        <string>it</string>
        <string>ro</string>
        <string>fr</string>
        <string>de</string>
    </array>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>org.airlance.routes</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>airlance</string>
            </array>
        </dict>
    </array>
    <key>CFBundleDisplayName</key>
    <string>Airlance</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>Default Configuration</string>
                    <key>UISceneDelegateClassName</key>
                    <string>Airlance.SceneDelegate</string>
                </dict>
            </array>
        </dict>
    </dict>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Airlance turns voice messages into text right on your iPhone.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Airlance uses the microphone for voice messages and calls.</string>
    <key>NSCameraUsageDescription</key>
    <string>Airlance uses the camera to take photos and videos, record video messages and make video calls.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Airlance uses your photos and videos so you can send them in chats.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Airlance saves photos and videos from chats to your library.</string>
    <key>PHPhotoLibraryPreventAutomaticLimitedAccessAlert</key>
    <true/>
    <key>NSContactsUsageDescription</key>
    <string>Airlance uses your contacts to find friends who use the app and to share contacts in chats.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Airlance uses your location when you send it to a chat.</string>
</dict>
</plist>
